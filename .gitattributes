# Vendored HL7 test-suite files are kept byte for byte as upstream ships them (some use CRLF);
# fixtures/source.json records their checksums.
tools/conformance/fixtures/** -text

# The conformance baseline is one passing test ID per line, sorted. `merge=union` keeps the lines of
# both sides when two PRs record different passing tests, so they do not conflict; the order does not
# matter to the runner, and the next `pnpm conformance --update-baseline` sorts the file again.
tools/conformance/baseline/*.txt text eol=lf merge=union

# The UCUM essence file and license ship unchanged; packages/ucum/data/source.json records their
# checksums, and tests compare the bytes.
packages/ucum/data/ucum-essence.xml -text
packages/ucum/UCUM-LICENSE.md -text
