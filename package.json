{
  "name": "callis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p scripts && pnpm --recursive run typecheck",
    "lint": "biome ci",
    "format": "biome check --write",
    "check:packages": "pnpm --filter \"./packages/*\" run check:package && node scripts/check-runtime-deps.ts && node scripts/report-size.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:packages",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
